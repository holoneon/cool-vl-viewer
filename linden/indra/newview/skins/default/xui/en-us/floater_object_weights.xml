<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<floater name="object weights" title="Object weights"
 can_resize="false" can_drag_on_left="false" can_minimize="true" can_close="true"
 rect_control="FloaterObjectWeightsRect"
 width="200" min_width="200" height="220" min_height="220" follows="top|left">
	<text name="selected_objects_label" font="SansSerifSmall"
	 left="10" bottom_delta="-40" width="110" height="16" follows="top|left">
		Selected objects:
	</text>
	<text name="selected_objects_count" font="SansSerifSmall"
	 left_delta="120" bottom_delta="0" width="60" height="16" follows="top|left" />
	<text name="objects_impact_label" font="SansSerifSmall"
	 left="10" bottom_delta="-20" width="110" height="16" follows="top|left">
		Land impact:
	</text>
	<text name="objects_impact" font="SansSerifSmall"
	 left_delta="120" bottom_delta="0" width="60" height="16" follows="top|left" />
	<text name="objects_physics_label" font="SansSerifSmall"
	 left="10" bottom_delta="-20" width="110" height="16" follows="top|left">
		Physics cost:
	</text>
	<text name="objects_physics_cost" font="SansSerifSmall"
	 left_delta="120" bottom_delta="0" width="60" height="16" follows="top|left" />
	<text name="selected_prims_label" font="SansSerifSmall"
	 left="10" bottom_delta="-32" width="110" height="16" follows="top|left">
		Selected primitives:
	</text>
	<text name="selected_prims_count" font="SansSerifSmall"
	 left_delta="120" bottom_delta="0" width="60" height="16" follows="top|left" />
	<text name="prims_impact_label" font="SansSerifSmall"
	 left="10" bottom_delta="-20" width="110" height="16" follows="top|left">
		Land impact:
	</text>
	<text name="prims_impact" font="SansSerifSmall"
	 left_delta="120" bottom_delta="0" width="60" height="16" follows="top|left" />
	<text name="prims_physics_label" font="SansSerifSmall"
	 left="10" bottom_delta="-20" width="110" height="16" follows="top|left">
		Physics cost:
	</text>
	<text name="prims_physics_cost" font="SansSerifSmall"
	 left_delta="120" bottom_delta="0" width="60" height="16" follows="top|left" />
	<text name="streaming_cost_label" font="SansSerifSmall"
	 left="10" bottom_delta="-20" width="110" height="16" follows="top|left">
		Streaming cost:
	</text>
	<text name="streaming_cost" font="SansSerifSmall"
	 left_delta="120" bottom_delta="0" width="60" height="16" follows="top|left" />
	<text name="triangle_count_label" font="SansSerifSmall"
	 left="10" bottom_delta="-20" width="110" height="16" follows="top|left">
		Triangle count:
	</text>
	<text name="triangle_count" font="SansSerifSmall"
	 left_delta="120" bottom_delta="0" width="60" height="16" follows="top|left" />
	<text name="render_cost_label" font="SansSerifSmall" mouse_opaque="true"
	 tool_tip="Please note that the render cost displayed here is an arbitrary (and plain bogus) calculation (similar to the Avatar Render Cost) and does not actually reflect the rendering time for any specific hardware or viewer (for example 100% transparent faces are not rendered at all by most viewers but get a 4 times cost factor applied to their associated objects because alpha blending is costly... when at all rendered)."
	 left="10" bottom_delta="-20" width="110" height="16" follows="top|left">
		Rendering cost:
	</text>
	<text name="objects_render_cost" font="SansSerifSmall" mouse_opaque="true"
	 tool_tip="Please note that the render cost displayed here is an arbitrary (and plain bogus) calculation (similar to the Avatar Render Cost) and does not actually reflect the rendering time for any specific hardware or viewer (for example 100% transparent faces are not rendered at all by most viewers but get a 4 times cost factor applied to their associated objects because alpha blending is costly... when at all rendered)."
	 left_delta="120" bottom_delta="0" width="60" height="16" follows="top|left" />
</floater>
