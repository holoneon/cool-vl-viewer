<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<floater name="voice settings" title="Voice chat device settings"
 can_drag_on_left="false" can_minimize="false" can_resize="false"
 bottom="0" height="280" left="0" width="406">
	<text name="audio_devices" font="SansSerifSmall" halign="left"
	  left="12" bottom="-36" width="200" height="16" follows="left|top">
		Audio devices
	</text>
	<text name="input_device_label" font="SansSerifSmall" halign="left"
     left="20" bottom_delta="-22" width="180" height="16" follows="left|top">
		Input device (microphone):
	</text>
	<text name="input_device_loading" font="SansSerifSmall" halign="left"
	 text_color="white" visible="false"
     left_delta="200" bottom_delta="0" width="100" height="16" follows="left|top">
		Loading...
	</text>
	<combo_box name="voice_input_device" max_chars="128" allow_text_entry="false"
	 left="20" bottom_delta="-20" width="364" height="18" follows="left|top" />
	<text name="output_device_label" font="SansSerifSmall" halign="left"
	 left="20" bottom_delta="-25" width="180" height="16" follows="left|top">
		Output device (speakers):
	</text>
	<text name="output_device_loading" font="SansSerifSmall" halign="left"
	 text_color="white" visible="false"
     left_delta="200" bottom_delta="0" width="100" height="16" follows="left|top">
		Loading...
	</text>
	<combo_box name="voice_output_device" max_chars="128" allow_text_entry="false"
	 left="20" bottom_delta="-20" width="364" height="18" follows="left|top" />
	<text name="input_level_label" font="SansSerifSmall" halign="left"
	 left="12" bottom_delta="-30" width="200" height="16" follows="left|top">
		Input level
	</text>
	<text_editor name="voice_intro_text1" font="SansSerifSmall" max_length="65535" word_wrap="true"
	 bg_readonly_color="0 0 0 0" hide_border="true" hide_scrollbar="true" enabled="false"
	 left_delta="10" width="380" height="60" follows="left|top">
		Adjust the slider to control how loud you sound to other residents. To test the input level, simply speak into your microphone.
	</text_editor>
	<slider name="mic_volume_slider" show_text="false"
	 increment="0.05" initial_val="1" max_val="2" min_val="0"
	 tool_tip="Change the volume using this slider"
	 left_delta="5" bottom_delta="-18" width="90" height="17" follows="left|top" />
	<text name="wait_text"
	 left_delta="95" bottom_delta="-4" width="200" height="20" follows="left|top">
		Please wait
	</text>
	<locate name="bar0" left_delta="0" bottom_delta="-5" width="20" height="20" />
	<locate name="bar1" left_delta="22" bottom_delta="0" width="20" height="20" />
	<locate name="bar2" left_delta="22" bottom_delta="0" width="20" height="20" />
	<locate name="bar3" left_delta="22" bottom_delta="0" width="20" height="20" />
	<locate name="bar4" left_delta="22" bottom_delta="0" width="20" height="20" />
	<button name="cancel_btn" label="Cancel" font="SansSerif"
	 left="40" bottom_delta="-28" width="80" height="20" follows="left|bottom" />
	<button name="apply_btn" label="Apply" font="SansSerif"
	 right="-40" bottom_delta="0" width="80" height="20" follows="right|bottom" />
	<string name="default_text">Default</string>
</floater>
