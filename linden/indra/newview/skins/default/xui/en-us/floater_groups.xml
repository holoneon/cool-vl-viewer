<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<floater name="groups" title="Groups" rect_control="FloaterGroupsRect"
 can_close="true" can_drag_on_left="false" can_minimize="true" can_resize="true" can_tear_off="false"
 width="280" min_width="275" height="300" min_height="200" follows="top|right">
	<text name="groupdesc" font="SansSerifSmall" length="1" enabled="true" mouse_opaque="false"
	 halign="left" tab_stop="false" drop_shadow_visible="true"
	 left="12" bottom="-36" width="248" height="16" follows="left|top">
		Your currently active group is displayed in bold.
	</text>
	<scroll_list name="group list" enabled="true"  mouse_opaque="true"
	 multi_select="false" tab_stop="true" column_padding="0"
	 background_visible="true" draw_heading="true" draw_stripes="true" draw_border="true"
	 left="12" bottom="-212" width="258" height="178" follows="left|top|right|bottom">
		<column name="name" label="Group name" dynamicwidth="true"
		 tool_tip="Double-click to start an IM session with a group" />
		<column name="profile" image="ff_visible_online_button.tga" width="20" tool_tip="Group is visible in profile." />
		<column name="chat" image="fg_chat_button.tga" width="20" tool_tip="Receive group chat." />
		<column name="notices" image="fg_notices_button.tga" width="20" tool_tip="Receive group notices." />
	</scroll_list>
	<text name="groupcount" font="SansSerifSmall" length="1" enabled="true" mouse_opaque="false"
	 halign="left" tab_stop="false" drop_shadow_visible="true"
	 left="12" bottom="-228" width="250" height="16" follows="left|bottom">
		You belong to [COUNT] groups (of [MAX] maximum).
	</text>
	<text name="filter_text" font="SansSerifSmall"
	 left="12" bottom="-244" width="40" height="16" follows="left|bottom">
		Filter:
	</text>
	<search_editor name="filter_search" font="SansSerifSmall" label="Type the search string here"
	 tool_tip="Type a search string here to filter by group names in the list."
	 left_delta="42" bottom_delta="0" height="16" width="210" />
	<button name="Activate" label="Activate" font="SansSerif" mouse_opaque="true" enabled="false"
	 left="8" bottom="-268" width="70" height="20" follows="left|bottom"/>
	<button name="Info" label="Info" font="SansSerif" mouse_opaque="true"
	 left_delta="74" bottom_delta="0" width="70" height="20" follows="left|bottom"/>
	<button name="Titles..." label="Titles..." font="SansSerif" mouse_opaque="true"
	 left_delta="74" bottom_delta="0" width="70" height="20" follows="left|bottom"/>
	<button name="IM" label="IM" font="SansSerif" mouse_opaque="true"
	 left_delta="74" bottom_delta="0" width="38" height="20" follows="left|bottom"/>
	<button name="Leave" label="Leave" font="SansSerif" mouse_opaque="true"
	 left="8" bottom="-290" width="70" height="20" follows="left|bottom"/>
	<button name="Create" label="Create" font="SansSerif" mouse_opaque="true"
	 left_delta="74" bottom_delta="0" width="70" height="20" follows="left|bottom"/>
	<button name="Search..." label="Search..." font="SansSerif" mouse_opaque="true"
	 left_delta="74" bottom_delta="0" width="70" height="20" follows="left|bottom"/>
	<button name="OK" label="OK" font="SansSerif" mouse_opaque="true"
	 left_delta="74" bottom_delta="0" width="38" height="20" follows="left|bottom"/>
	<string name="none">
		none
	</string>
</floater>
